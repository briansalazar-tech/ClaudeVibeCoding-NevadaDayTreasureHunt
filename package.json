{
  "name": "nevada-day-treasure-hunt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scouting map and field notebook for the Nevada Day Treasure Hunt",
  "workspaces": [
    "shared",
    "client",
    "server",
    "data-pipeline"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "start": "cross-env NODE_ENV=production npm run start --workspace server",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "npm run db:migrate --workspace server",
    "data:fetch": "tsx data-pipeline/src/fetch.ts",
    "data:build": "tsx data-pipeline/src/build.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
