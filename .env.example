# Copy to .env and adjust. .env is never committed.

# Client (Vite dev server)
CLIENT_PORT=5173
# Set to 0.0.0.0 to open the dev server to phones on the same network.
CLIENT_HOST=

# Server (API, SQLite). Paths are relative to the repo root.
PORT=3001
# Set to 0.0.0.0 to reach the API server directly from other devices (not needed for the dev
# server, which forwards /api).
HOST=
DATABASE_PATH=server/data/hunt.db
UPLOADS_DIR=server/data/uploads
# Leave empty: the client calls /api on its own origin, and the Vite dev and preview servers
# forward it to PORT. Set it only when the API is hosted somewhere else.
VITE_API_URL=
# Sent to Nominatim and the Census geocoder (address search), and by the data pipeline to
# Overpass and Wikipedia. Include a contact address. Left empty, a generic app name is sent.
GEOCODER_USER_AGENT=NevadaDayHuntMap/0.1 (your-email@example.com)
# The processed map data; the server reads the county boundaries from it to keep address
# results inside the hunt counties.
MAP_DATA_DIR=client/public/data
# Address search services. The defaults are the public ones; change them only to use another
# Nominatim instance or a proxy.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov/geocoder/locations/onelineaddress
